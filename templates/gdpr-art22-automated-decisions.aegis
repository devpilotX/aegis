// TEMPLATE: GDPR Article 22 - Automated Decision-Making
// Purpose: Decisions with legal or similarly significant effect require human involvement.
// Adapt the constants and the applies_to target. Do not remove the citation.
specification "1.0"
package templates.gdpr_art22_automated_decisions
import std.eu_ai_act as eu
import std.nist_ai_rmf as nist
import std.iso42001 as iso42001
import std.gdpr as gdpr
import std.soc2 as soc2

const approval_freshness = 5m
const max_eval_age       = 30d
const min_score          = 0.90

/// Decisions with legal or similarly significant effect require human involvement.
policy human_review_right {
  combining  deny_overrides
  applies_to true                    // NARROW THIS before deployment
  cites gdpr.article(22)

  rule human_review_right {
    deny action.affects_data_subject == true
    unless human.approved_by(data_protection_reviewer) within 24h
      reason "Decisions with legal or similarly significant effect require human involvement."
  }

  default deny

  on violation {
    halt
    audit.emit(severity: high, evidence: full_trace)
    notify("governance-oncall")
  }
}

test "template compiles and denies by default" {
  given { }
  expect deny
}
