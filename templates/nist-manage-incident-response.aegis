// TEMPLATE: NIST AI RMF - MANAGE, Incident Response
// Purpose: While an incident is open, autonomous consequential actions are suspended.
// Adapt the constants and the applies_to target. Do not remove the citation.
specification "1.0"
package templates.nist_manage_incident_response
import std.eu_ai_act as eu
import std.nist_ai_rmf as nist
import std.iso42001 as iso42001
import std.gdpr as gdpr
import std.soc2 as soc2

const approval_freshness = 5m
const max_eval_age       = 30d
const min_score          = 0.90

/// While an incident is open, autonomous consequential actions are suspended.
policy incident_containment {
  combining  deny_overrides
  applies_to true                    // NARROW THIS before deployment
  cites nist.subcategory("MANAGE-4.1")

  rule incident_containment {
    deny context.incident_open == true
      reason "While an incident is open, autonomous consequential actions are suspended."
  }

  default deny

  on violation {
    halt
    audit.emit(severity: high, evidence: full_trace)
    notify("governance-oncall")
  }
}

test "template compiles and denies by default" {
  given { }
  expect deny
}
