// TEMPLATE: EU AI Act Article 5 - Prohibited Practices
// Purpose: Prohibited practices are refused outright, with no override path.
// Adapt the constants and the applies_to target. Do not remove the citation.
specification "1.0"
package templates.eu_ai_act_art5_prohibited
import std.eu_ai_act as eu
import std.nist_ai_rmf as nist
import std.iso42001 as iso42001
import std.gdpr as gdpr
import std.soc2 as soc2

const approval_freshness = 5m
const max_eval_age       = 30d
const min_score          = 0.90

/// Prohibited practices are refused outright, with no override path.
policy prohibited_practices {
  combining  deny_overrides
  applies_to true                    // NARROW THIS before deployment
  cites eu.article(5)

  rule prohibited_practices {
    deny action.purpose in prohibited_purposes
      reason "Prohibited practices are refused outright, with no override path."
  }

  default deny

  on violation {
    halt
    audit.emit(severity: high, evidence: full_trace)
    notify("governance-oncall")
  }
}

test "template compiles and denies by default" {
  given { }
  expect deny
}
